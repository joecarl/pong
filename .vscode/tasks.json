{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-server",
			"type": "shell",
			"command": "make",
			"args": [
				"-j$(nproc)",
				"server"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "build-client",
			"type": "shell",
			"command": "make",
			"args": [
				"-j$(nproc)",
				"client"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": [
				"$gcc"
			]
		}
	]
}